# Copiá este archivo a .env.local y completá los valores reales.
# .env.local nunca se commitea (está en .gitignore).

# Supabase — obligatorias. Sin esto, `pnpm build` y `pnpm dev` fallan
# (ver el chequeo en src/lib/supabase.ts). Las sacás del dashboard del
# proyecto en supabase.com > Project Settings > API.

# URL del proyecto y clave pública (anon). Se usan en el navegador
# (prefijo NEXT_PUBLIC_), así que terminan en el bundle del cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mismos valores que arriba, pero sin el prefijo NEXT_PUBLIC_: los usa
# scripts/send-reminders.ts (el cron de GitHub Actions), que corre en
# Node y no en el navegador. SUPABASE_SERVICE_KEY es la clave "service
# role" (no la anon key) porque el script necesita permisos de escritura
# sin pasar por Row Level Security.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Credenciales del correo que envía los recordatorios automáticos
# (scripts/send-reminders.ts, vía nodemailer con el servicio de Gmail).
# EMAIL_PASS es una contraseña de aplicación de Gmail, no la contraseña
# normal de la cuenta.
EMAIL_USER=
EMAIL_PASS=

# EmailJS — actualmente sin uso: el hook que las consume
# (src/features/warranty/hooks/useReminderEmail.ts) no se llama desde
# ningún lado. El envío real de recordatorios lo hace el script de
# nodemailer de arriba. Se dejan documentadas por si se retoma el envío
# de emails desde el navegador.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
